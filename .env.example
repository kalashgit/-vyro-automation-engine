# Never commit real credentials or expose them through NEXT_PUBLIC_*.
# /api/health is public liveness. Dashboard and all other APIs fail closed.
ADMIN_USERNAME=
# Use a unique password of at least 16 characters, served over HTTPS.
ADMIN_PASSWORD=

# PostgreSQL. Leave unset to show NOT CONFIGURED. Migrate explicitly; no startup DDL.
DATABASE_URL=
# verify-full is the default. disable is allowed only for loopback development/CI.
DATABASE_SSL_MODE=verify-full
# Optional custom trusted CA PEM. Do not put query parameters or fragments in DATABASE_URL.
DATABASE_SSL_CA=

# Reserved later integrations. No external API or outbound messaging is implemented.
API_BASE_URL=
API_KEY=

# Tests use an isolated schema on a LOCAL disposable DB ending in _test.
# Never set this to a production database; test commands fail if absent.
TEST_DATABASE_URL=

# Collection only. Explicit queue intake: scripts/enrich-contacts.mjs.
WORKER_ENABLED=false
ACQUISITION_HANDLERS_ENABLED=false
ENRICHMENT_ENABLED=false
WORKER_CONCURRENCY=1
